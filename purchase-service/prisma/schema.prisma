// Schéma Prisma généré pour Prisma 7.
// La datasource ne porte que le provider : l'URL de connexion vit dans
// prisma.config.ts (variable d'environnement DATABASE_URL) et le client
// reçoit un driver adapter (@prisma/adapter-pg) au runtime.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Un achat, souvent un lot : son prix et ses frais sont répartis entre les
// exemplaires qu'il a ajoutés au stock d'inventory.
model Purchase {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  supplier       String
  purchasedAt    DateTime @db.Date
  price          Decimal  @db.Decimal(12, 2)
  // Port, commissions : ils font partie du coût de chaque exemplaire.
  fees           Decimal  @default(0) @db.Decimal(12, 2)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  lines PurchaseLine[]

  @@index([organizationId, purchasedAt])
}

// Un exemplaire acheté. Le produit et l'état sont copiés depuis inventory :
// l'achat reste lisible quand l'exemplaire quitte le stock.
model PurchaseLine {
  id              String   @id @default(uuid()) @db.Uuid
  purchaseId      String   @db.Uuid
  purchase        Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  position        Int
  inventoryItemId String   @unique @db.Uuid
  productId       String   @db.Uuid
  productName     String
  productType     String
  setCode         String?
  setName         String?
  cardNumber      String?
  imageUrl        String?
  condition       String?
  language        String?
  gradingCompany  String?
  grade           Decimal? @db.Decimal(3, 1)
  reverse         Boolean
  // Price Trend Cardmarket le jour de l'achat : la base de la répartition.
  marketPrice     Decimal? @db.Decimal(12, 2)
  cost            Decimal  @db.Decimal(12, 2)

  @@unique([purchaseId, position])
}
