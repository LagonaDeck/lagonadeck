// Schéma Prisma généré pour Prisma 7.
// La datasource ne porte que le provider : l'URL de connexion vit dans
// prisma.config.ts (variable d'environnement DATABASE_URL) et le client
// reçoit un driver adapter (@prisma/adapter-pg) au runtime.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Une vente, d'un ou plusieurs exemplaires sortis du stock d'inventory : son
// prix et ses frais sont répartis entre eux.
model Sale {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  buyer          String
  soldAt         DateTime @db.Date
  price          Decimal  @db.Decimal(12, 2)
  // Commission de la plateforme, port payé : ils réduisent la marge.
  fees           Decimal  @default(0) @db.Decimal(12, 2)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  lines SaleLine[]

  @@index([organizationId, soldAt])
}

// Un exemplaire vendu. Le produit et l'état sont copiés depuis inventory, que
// l'exemplaire quitte ; le coût, depuis purchase.
model SaleLine {
  id              String   @id @default(uuid()) @db.Uuid
  saleId          String   @db.Uuid
  sale            Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  position        Int
  // Un exemplaire n'est vendu qu'une fois : deux ventes simultanées du même
  // exemplaire, la seconde est refusée.
  inventoryItemId String   @unique @db.Uuid
  productId       String   @db.Uuid
  productName     String
  productType     String
  setCode         String?
  setName         String?
  cardNumber      String?
  imageUrl        String?
  condition       String?
  language        String?
  gradingCompany  String?
  grade           Decimal? @db.Decimal(3, 1)
  reverse         Boolean
  // Price Trend Cardmarket le jour de la vente : la base de la répartition.
  marketPrice     Decimal? @db.Decimal(12, 2)
  price           Decimal  @db.Decimal(12, 2)
  fees            Decimal  @db.Decimal(12, 2)
  // Coût d'achat ; null pour un exemplaire entré au stock sans achat.
  cost            Decimal? @db.Decimal(12, 2)

  @@unique([saleId, position])
}
