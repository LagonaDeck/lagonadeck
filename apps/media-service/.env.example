# Connexion PostgreSQL du service (database-per-service).
# Valeurs alignées sur infrastructure/docker-compose.dev.yml (base lagonadeck_media,
# bucket lagonadeck-media) — remplacer `postgres` par `localhost` hors Docker.
DATABASE_URL="postgresql://lagonadeck:lagonadeck@localhost:5432/lagonadeck_media?schema=public"

# Object storage des binaires média (MinIO en local, S3 en prod).
MEDIA_S3_ENDPOINT="http://localhost:9000"
MEDIA_S3_REGION="us-east-1"
MEDIA_S3_BUCKET="lagonadeck-media"
MEDIA_S3_ACCESS_KEY_ID="lagonadeck"
MEDIA_S3_SECRET_ACCESS_KEY="lagonadeck-dev-password"
MEDIA_S3_FORCE_PATH_STYLE="true"

# Taille maximale acceptée pour un fichier uploadé, en octets (défaut : 25 Mo).
MEDIA_MAX_UPLOAD_SIZE_BYTES="26214400"
