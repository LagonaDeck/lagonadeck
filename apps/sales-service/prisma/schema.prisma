// Schéma Prisma généré pour Prisma 7.
// La datasource ne porte que le provider : l'URL de connexion vit dans
// prisma.config.ts (variable d'environnement DATABASE_URL) et le client
// reçoit un driver adapter (@prisma/adapter-pg) au runtime.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// sales-db — résultat des ventes. Sales ne modifie jamais inventory-db :
// `workspaceId`, `inventoryItemId` et `cardVariantId` sont des références
// logiques vers d'autres bases (UUID sans clé étrangère).
// Bénéfice, marge et ROI se calculent à partir des lignes : ils ne sont pas stockés.

enum SaleStatus {
  DRAFT
  PAID
  SHIPPED
  COMPLETED
  CANCELLED
}

enum SaleFeeType {
  MARKETPLACE_COMMISSION
  PAYMENT
  SHIPPING_COST
  PACKAGING
  OTHER
}

// Canal de vente du workspace, configurable par l'utilisateur : la liste ne
// peut pas être connue à l'avance (ricardo.ch, un salon local…), d'où une
// table de référence plutôt qu'une énumération.
model Marketplace {
  id             String   @id @default(uuid()) @db.Uuid
  workspaceId    String   @db.Uuid
  name           String
  // Identifiant stable dérivé du nom, pour référencer un canal sans dépendre
  // de son libellé (que l'utilisateur peut renommer).
  slug           String
  // Commission habituelle du canal (0.0500 = 5 %), proposée à la saisie d'une
  // vente ; le montant réellement retenu est figé dans `SaleFee`.
  defaultFeeRate Decimal? @db.Decimal(6, 4)
  // Un canal déjà utilisé par des ventes ne se supprime pas : il s'archive.
  isArchived     Boolean  @default(false)
  sales          Sale[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([workspaceId, slug])
  @@index([workspaceId, isArchived])
}

model Sale {
  id              String      @id @default(uuid()) @db.Uuid
  workspaceId     String      @db.Uuid
  marketplaceId   String      @db.Uuid
  marketplace     Marketplace @relation(fields: [marketplaceId], references: [id])
  // Pseudonyme de l'acheteur sur le canal : seule donnée personnelle conservée.
  buyerHandle     String?
  status          SaleStatus  @default(DRAFT)
  currency        String      @db.Char(3)
  // Frais de port facturés à l'acheteur.
  shippingCharged Decimal     @default(0) @db.Decimal(12, 2)
  soldAt          DateTime
  lines           SaleLine[]
  fees            SaleFee[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([workspaceId, soldAt])
  @@index([workspaceId, status])
  @@index([marketplaceId])
}

// Une carte vendue. Les champs `*Snapshot` figent le libellé et le coût de
// revient au moment de la vente, pour que la marge reste stable dans le temps.
model SaleLine {
  id                String      @id @default(uuid()) @db.Uuid
  saleId            String      @db.Uuid
  sale              Sale        @relation(fields: [saleId], references: [id], onDelete: Cascade)
  inventoryItemId   String      @db.Uuid
  cardVariantId     String      @db.Uuid
  cardNameSnapshot  String
  unitPrice         Decimal     @db.Decimal(12, 2)
  costBasisSnapshot Decimal     @db.Decimal(12, 2)
  saleReturn        SaleReturn?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([saleId])
  @@index([inventoryItemId])
}

// Frais supportés par le vendeur.
model SaleFee {
  id        String      @id @default(uuid()) @db.Uuid
  saleId    String      @db.Uuid
  sale      Sale        @relation(fields: [saleId], references: [id], onDelete: Cascade)
  type      SaleFeeType
  amount    Decimal     @db.Decimal(12, 2)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([saleId])
}

// Retour ou remboursement d'une ligne (au plus un par ligne).
model SaleReturn {
  id           String   @id @default(uuid()) @db.Uuid
  saleLineId   String   @unique @db.Uuid
  saleLine     SaleLine @relation(fields: [saleLineId], references: [id], onDelete: Cascade)
  refundAmount Decimal  @db.Decimal(12, 2)
  // Vrai si l'exemplaire réintègre le stock.
  restock      Boolean  @default(false)
  returnedAt   DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
