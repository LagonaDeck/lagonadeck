// Schéma Prisma généré pour Prisma 7.
// La datasource ne porte que le provider : l'URL de connexion vit dans
// prisma.config.ts (variable d'environnement DATABASE_URL) et le client
// reçoit un driver adapter (@prisma/adapter-pg) au runtime.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  // Requis par l'index unique partiel de `WorkspaceMember` (un seul OWNER).
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// Ordre croissant des droits : un rôle hérite des droits des rôles inférieurs.
enum WorkspaceRole {
  MEMBER
  ADMIN
  OWNER
}

// Identité d'un utilisateur : email unique (stocké normalisé), pseudo unique
// sans tenir compte de la casse via `pseudoNormalized` (cf. common/normalize.ts),
// mot de passe haché + salt (jamais en clair, cf. ADR 0007 pour l'algorithme et
// la stratégie de salage).
model User {
  id               String   @id @default(uuid()) @db.Uuid
  email            String   @unique
  firstName        String
  lastName         String
  // Tel que saisi, casse comprise : c'est la valeur affichée.
  pseudo           String
  // Minuscules : porte l'unicité, pour que `JaneDoe` et `janedoe` entrent en conflit.
  pseudoNormalized String   @unique
  passwordHash     String
  salt             String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  memberships     WorkspaceMember[]
  invitationsSent WorkspaceInvitation[]
}

// Espace de travail : les autres services y rattachent leurs données par
// `workspaceId` (référence logique, sans clé étrangère).
model Workspace {
  id   String @id @default(uuid()) @db.Uuid
  name String

  members     WorkspaceMember[]
  invitations WorkspaceInvitation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WorkspaceMember {
  workspaceId String        @db.Uuid
  userId      String        @db.Uuid
  role        WorkspaceRole @default(MEMBER)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([workspaceId, userId])
  @@unique([workspaceId], where: { role: "OWNER" }, map: "WorkspaceMember_single_owner_key")
  @@index([userId])
}

// Invitation en attente : supprimée à l'acceptation, au refus ou à la
// révocation. Ré-inviter la même adresse met à jour l'invitation existante.
model WorkspaceInvitation {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @db.Uuid
  // Normalisée comme `User.email` (cf. common/normalize.ts).
  email       String
  role        WorkspaceRole @default(MEMBER)
  invitedById String        @db.Uuid
  expiresAt   DateTime

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User      @relation(fields: [invitedById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, email])
  @@index([email])
}
