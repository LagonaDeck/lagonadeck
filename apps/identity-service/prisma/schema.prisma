// Schéma Prisma généré pour Prisma 7.
// La datasource ne porte que le provider : l'URL de connexion vit dans
// prisma.config.ts (variable d'environnement DATABASE_URL) et le client
// reçoit un driver adapter (@prisma/adapter-pg) au runtime.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Identité d'un utilisateur : email et pseudo uniques (stockés normalisés,
// cf. common/normalize.ts), mot de passe haché + salt (jamais en clair,
// cf. ADR 0007 pour l'algorithme et la stratégie de salage).
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  firstName    String
  lastName     String
  pseudo       String   @unique
  passwordHash String
  salt         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}
