// Schéma Prisma généré pour Prisma 7.
// La datasource ne porte que le provider : l'URL de connexion vit dans
// prisma.config.ts (variable d'environnement DATABASE_URL) et le client
// reçoit un driver adapter (@prisma/adapter-pg) au runtime.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Métadonnées des médias (les binaires vont sur l'object storage, cf. StorageService).
model MediaAsset {
  id          String      @id @default(uuid())
  ownerId     String
  fileName    String
  storageKey  String      @unique
  kind        MediaKind
  contentType String
  sizeBytes   Int
  width       Int?
  height      Int?
  status      MediaStatus @default(PENDING)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([ownerId])
}

enum MediaKind {
  IMAGE
  DOCUMENT
}

enum MediaStatus {
  PENDING
  READY
  FAILED
}
