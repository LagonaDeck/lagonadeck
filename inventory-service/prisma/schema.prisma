// Schéma Prisma généré pour Prisma 7.
// La datasource ne porte que le provider : l'URL de connexion vit dans
// prisma.config.ts (variable d'environnement DATABASE_URL) et le client
// reçoit un driver adapter (@prisma/adapter-pg) au runtime.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  // Requis par l'index unique partiel des produits saisis à la main.
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum ProductType {
  SINGLE
  BOOSTER
  BOOSTER_DISPLAY
  ELITE_TRAINER_BOX
  BOX_SET
  TIN
  BUNDLE
  PRECONSTRUCTED_DECK
  OTHER
}

// D'où vient le produit : il n'est mis à jour que par sa source.
enum ProductSource {
  TCGDEX // carte Pokémon
  CARDMARKET // produit scellé
  MANUAL // saisi par un utilisateur
}

// États Cardmarket.
enum Condition {
  MINT
  NEAR_MINT
  EXCELLENT
  GOOD
  LIGHT_PLAYED
  PLAYED
  POOR
}

enum GradingCompany {
  PSA
  BECKETT
  CGC
  SGC
  PCA
}

// Langues Cardmarket.
enum Language {
  ENGLISH
  FRENCH
  GERMAN
  SPANISH
  ITALIAN
  SIMPLIFIED_CHINESE
  JAPANESE
  PORTUGUESE
  RUSSIAN
  KOREAN
  TRADITIONAL_CHINESE
}

// Catalogue Pokémon, partagé par toutes les organisations. Une carte est
// identifiée par son set et son numéro (TCGdex) ; son prix vient du produit
// Cardmarket auquel elle est liée, quand le lien est sûr ou saisi à la main.
model Product {
  id                  String        @id @default(uuid()) @db.Uuid
  source              ProductSource
  productType         ProductType
  // Carte TCGdex : `<langue>/<set>-<numéro>` (`en/sv03.5-006`).
  tcgdexId            String?       @unique
  // Nom en français quand la source le donne, sinon dans sa langue.
  name                String
  englishName         String?
  setCode             String?
  setName             String?
  cardNumber          String?
  rarity              String?
  imageUrl            String?
  // Existe en reverse selon TCGdex ; null quand TCGdex ne liste pas les variantes.
  hasReverse          Boolean?
  // Talents et attaques en anglais, comparés au nom Cardmarket avant de lier.
  moves               String[]      @default([])
  // Identifiants Cardmarket que TCGdex annonce pour la carte : parfois faux.
  tcgdexCardmarketIds Int[]         @default([])

  cardmarketId           Int?               @unique
  cardmarketProduct      CardmarketProduct? @relation(fields: [cardmarketId], references: [id], onDelete: SetNull)
  // Lien saisi par un utilisateur : la synchronisation ne le remplace pas.
  cardmarketLinkedByUser Boolean            @default(false)

  // Nom, set et numéro normalisés (minuscules, sans accents), pour la recherche.
  searchText String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  inventoryItems InventoryItem[]
  reports        CatalogReport[]

  // Un produit saisi à la main n'est créé qu'une fois, même en concurrence.
  @@unique([productType, name, setCode, cardNumber], where: raw("\"source\" = 'MANUAL'"), map: "Product_manual_key")
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin)
}

enum ReportStatus {
  OPEN
  RESOLVED
}

// Signalement d'un utilisateur sur le catalogue : produit faux (prix, lien
// Cardmarket, informations) ou absent (`productId` vide). L'équipe le traite.
model CatalogReport {
  id         String       @id @default(uuid()) @db.Uuid
  productId  String?      @db.Uuid
  product    Product?     @relation(fields: [productId], references: [id], onDelete: Cascade)
  message    String
  // Utilisateurs d'identity.
  reportedBy String       @db.Uuid
  resolvedBy String?      @db.Uuid
  status     ReportStatus @default(OPEN)
  createdAt  DateTime     @default(now())
  resolvedAt DateTime?

  @@index([status, createdAt])
}

// Copie des fichiers publics Cardmarket (catalogue et price guide Pokémon).
model CardmarketProduct {
  id           Int       @id
  name         String
  categoryName String
  expansionId  Int?
  single       Boolean
  // Price guide en EUR : références par produit, pas par état ni langue.
  trend        Decimal?  @db.Decimal(12, 2)
  low          Decimal?  @db.Decimal(12, 2)
  avg1         Decimal?  @db.Decimal(12, 2)
  avg7         Decimal?  @db.Decimal(12, 2)
  avg30        Decimal?  @db.Decimal(12, 2)
  // Version reverse ou holo de la même carte.
  trendHolo    Decimal?  @db.Decimal(12, 2)
  priceDate    DateTime?

  product   Product?
  snapshots PriceSnapshot[]
}

// Relevé quotidien du price guide : Cardmarket ne publie que les prix du jour,
// l'historique se construit relevé après relevé.
model PriceSnapshot {
  cardmarketId      Int
  date              DateTime          @db.Date
  trend             Decimal?          @db.Decimal(12, 2)
  low               Decimal?          @db.Decimal(12, 2)
  avg1              Decimal?          @db.Decimal(12, 2)
  avg7              Decimal?          @db.Decimal(12, 2)
  avg30             Decimal?          @db.Decimal(12, 2)
  cardmarketProduct CardmarketProduct @relation(fields: [cardmarketId], references: [id], onDelete: Cascade)

  @@id([cardmarketId, date])
}

// Stock d'une organisation. Les colonnes facultatives font partie de la clé
// unique en NULLS NOT DISTINCT (voir la migration). Une carte gradée porte
// une société et une note à la place de l'état.
// Un exemplaire physique : il aura son emplacement et ses photos.
model InventoryItem {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @db.Uuid
  productId      String          @db.Uuid
  condition      Condition?
  language       Language?
  gradingCompany GradingCompany?
  grade          Decimal?        @db.Decimal(3, 1)
  // Valorisée au prix reverse du produit Cardmarket (`trendHolo`).
  reverse        Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  product Product @relation(fields: [productId], references: [id])

  @@index([organizationId])
  @@index([productId])
}

// Dernière synchronisation de chaque fichier importé (TCGdex, Cardmarket) :
// l'ETag évite de retélécharger un fichier inchangé.
model SyncedFile {
  url      String   @id
  etag     String
  syncedAt DateTime
}
